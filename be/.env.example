# Copy to .env and fill in. Nothing in here has a production-safe default: a
# missing required variable fails at boot, which is the point.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

# Leave POSTGRES_DB empty to fall back to SQLite for local work.
POSTGRES_DB=recruit
POSTGRES_USER=recruit
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# The Next.js site. Both the CORS allow-list and the origin used in emails and
# push deep links.
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_ORIGIN=http://localhost:3000

MEDIA_ROOT=
MEDIA_URL=/media/

# SMS OTP (Fast2SMS over DLT). Without SMS_TEMPLATE_ID the provider's own OTP
# route is used, which works before the client's DLT registration is through.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# Numbers that skip the gateway and accept OTP_TEST_CODE — for Play Store review
# and for demoing the panel without burning SMS credits.
OTP_TEST_PHONES=
OTP_TEST_CODE=000000

FCM_CREDENTIALS_FILE=secrets/firebase-admin.json
GOOGLE_OAUTH_CLIENT_IDS=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# The firm's inbox — contact forms and new applications land here.
OFFICE_EMAIL=
