# Production environment. Copy to .env on the server and fill in.
#   cp .env.example .env
# Never commit the filled-in file. `.gitignore` already covers `.env*`.
#
# Generate the two secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"   # DJANGO_SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD

# ---- the one thing every other value follows from -------------------------
DOMAIN=jeewansir.in
SITE_ORIGIN=https://jeewansir.in

# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=jeewansir.in,www.jeewansir.in,be
DJANGO_CSRF_TRUSTED_ORIGINS=https://jeewansir.in,https://www.jeewansir.in

# Same origin, so this is only a safety net rather than something load-bearing.
CORS_ALLOWED_ORIGINS=https://jeewansir.in,https://www.jeewansir.in

# OTP_CONSOLE_FALLBACK defaults to DEBUG, which is false here. Stated anyway so
# nobody can claim it was on by accident: with this false and no SMS_API_KEY,
# nobody can sign in. Fill in the SMS credentials before handover.
OTP_CONSOLE_FALLBACK=false

# ---- Postgres -------------------------------------------------------------
POSTGRES_DB=recruit
POSTGRES_USER=recruit
POSTGRES_PASSWORD=

# ---- SMS (Fast2SMS over DLT) ----------------------------------------------
# Without SMS_TEMPLATE_ID the provider's own OTP route is used, which works
# before the client's DLT registration comes through.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# Office and demo numbers that skip the gateway. Clear these before handover
# unless the client wants a permanent demo login.
OTP_TEST_PHONES=
OTP_TEST_CODE=000000

# ---- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Contact forms and new applications land here.
OFFICE_EMAIL=

# ---- Push (optional; the app phase needs it, the website does not) ---------
FCM_CREDENTIALS_FILE=secrets/firebase-admin.json
GOOGLE_OAUTH_CLIENT_IDS=
