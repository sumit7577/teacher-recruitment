# Production environment. Copy to .env on the server and fill in.
#   cp .env.example .env
# Never commit the filled-in file. `.gitignore` already covers `.env*`.
#
# Generate the two secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"   # DJANGO_SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD

# ---- the one thing every other value follows from -------------------------
DOMAIN=jeewansir.in
SITE_ORIGIN=https://jeewansir.in

# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=jeewansir.in,www.jeewansir.in,be
DJANGO_CSRF_TRUSTED_ORIGINS=https://jeewansir.in,https://www.jeewansir.in

# Same origin, so this is only a safety net rather than something load-bearing.
CORS_ALLOWED_ORIGINS=https://jeewansir.in,https://www.jeewansir.in


# ---- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Contact forms and new applications land here.
OFFICE_EMAIL=

# ---- Push (optional; the app phase needs it, the website does not) ---------
FCM_CREDENTIALS_FILE=secrets/firebase-admin.json
GOOGLE_OAUTH_CLIENT_IDS=

# ---- File storage: Bunny CDN ----------------------------------------------
# With no access key the app falls back to the local disk under MEDIA_ROOT and
# everything still works — that is what a fresh clone runs on. Set these and
# uploads go to the CDN instead. Files written before the switch keep loading:
# BunnyStorage.url() recognises an old relative path and serves it from
# MEDIA_URL, so there is no backfill and no downtime.
#
# Create a Storage Zone at bunny.net, then read the password off its FTP &
# API Access page. Pin the zone to Singapore for Indian traffic.
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_PUBLIC_HOST=
# Region endpoint for the zone above. Frankfurt (the default) is
# storage.bunnycdn.com; a Singapore zone is sg.storage.bunnycdn.com. Getting
# this wrong returns a 401 that reads exactly like a bad access key.
BUNNY_STORAGE_API_HOST=storage.bunnycdn.com

# ---- Payments: Razorpay ---------------------------------------------------
# Unset, every payment endpoint answers "payments are not switched on yet"
# rather than failing — so the platform runs without an account.
#
# The KEY_ID is public (it ships in the page source of every Razorpay
# checkout). The other two never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A SEPARATE value, generated when you add the webhook in the Razorpay
# dashboard. It is NOT the API secret. Using one where the other belongs
# rejects every genuine event while looking entirely correct.
#
# Webhook URL to register:  https://<DOMAIN>/razorpay-webhook/
# Events to subscribe:      payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=
