# Production environment. Copy to .env on the server and fill in.
#   cp .env.example .env
# Never commit the filled-in file. `.gitignore` already covers `.env*`.
#
# Generate the two secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"   # DJANGO_SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD

# ---- the one thing every other value follows from -------------------------
DOMAIN=jeewansir.in
SITE_ORIGIN=https://jeewansir.in

# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=jeewansir.in,www.jeewansir.in,be
DJANGO_CSRF_TRUSTED_ORIGINS=https://jeewansir.in,https://www.jeewansir.in

# Same origin, so this is only a safety net rather than something load-bearing.
CORS_ALLOWED_ORIGINS=https://jeewansir.in,https://www.jeewansir.in


# ---- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Contact forms and new applications land here.
OFFICE_EMAIL=

# ---- Push (optional; the app phase needs it, the website does not) ---------
FCM_CREDENTIALS_FILE=secrets/firebase-admin.json
GOOGLE_OAUTH_CLIENT_IDS=
